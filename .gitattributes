# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts run inside Linux/Docker: always LF, even with core.autocrlf=true
*.sh text eol=lf

# Windows batch files: always CRLF (cmd label/goto parsing breaks on LF-only files)
*.bat text eol=crlf

# CMake scripts (LeonBuildTool) run inside Docker too: LF everywhere
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# PowerShell scripts: CRLF
*.ps1 text eol=crlf

# LeonHeaderTool golden tests compare generated files byte for byte: keep their inputs and outputs LF everywhere
Engine/Source/Programs/LeonHeaderTool/Tests/** text eol=lf

# Binary content: packages (.lasset / .lmap), paks (.lpak, P16), binary glTF source art (.glb) and Blender sources (.blend,
# P17), source sounds (.wav, P18)
*.lasset binary
*.lmap binary
*.glb binary
*.blend binary
*.wav binary
*.lpak binary
*.png binary
*.pdf binary

# Mesh sources whose bytes are hashed at import (UAssetImportData's MD5, the import identity): no line-ending conversion
*.obj -text
*.gltf -text
