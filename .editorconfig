# Editor defaults matching .clang-format (Epic coding standard) and .gitattributes line endings.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,inl,cpp,c}]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[{*.cmake,CMakeLists.txt}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,lproj,lplugin,yml,yaml}]
indent_style = space
indent_size = 2

[*.{glsl,vert,frag}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.sh]
end_of_line = lf

# Third-party code keeps its upstream style.
[{Engine/Source/ThirdParty/**,Engine/Plugins/**/ThirdParty/**}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
