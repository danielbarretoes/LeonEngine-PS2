# Epic Games coding standard (UE 4.27) for LeonEngine C++: tabs for indentation, braces on their
# own line (Allman), 120 columns, `public:` aligned with its class, BeforeComma initializer lists.
# ThirdParty folders carry their own .clang-format with DisableFormat. GLSL is never formatted.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
UseTab: ForContinuationAndIndentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 120
BreakBeforeBraces: Allman
AccessModifierOffset: -4
NamespaceIndentation: All
IndentCaseLabels: true
IndentPPDirectives: BeforeHash
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: All
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AlwaysBreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: Never
BreakInheritanceList: BeforeComma
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignTrailingComments: false
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
BinPackArguments: true
BinPackParameters: true
PointerAlignment: Left
ReferenceAlignment: Left
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpaceBeforeCpp11BracedList: false
Cpp11BracedListStyle: true
FixNamespaceComments: true
LambdaBodyIndentation: Signature
MaxEmptyLinesToKeep: 1
# Includes: the module's own header stays first (main include), then engine headers, then third
# party, then system / SDK headers. A reflected header's "<Name>.generated.h" stays the last engine include
# (LeonHeaderTool requires it, as UHT does).
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '$'
# Within the third-party block, prerequisite headers sort first (Jolt/Jolt.h, glad before GLFW).
IncludeCategories:
  - Regex: '\.generated\.h"$'
    Priority: 1
    SortPriority: 2
  - Regex: '^"'
    Priority: 1
  - Regex: '^<(Jolt/Jolt\.h|glad/)'
    Priority: 3
    SortPriority: 3
  - Regex: '^<(GLFW|glm|nlohmann|stb_|miniaudio|enet|ufbx|cgltf|tiny_obj|catch2|Jolt)'
    Priority: 3
    SortPriority: 4
  - Regex: '^<'
    Priority: 5
