# Unreal-style generated folders (LeonBuildTool)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
/compile_commands.json
!/Engine/Build/
!/Engine/Build/**
# Downloaded third-party sources (Setup.bat)
Engine/Source/ThirdParty/*/*-[0-9]*/
Engine/Plugins/**/ThirdParty/*/*-[0-9]*/

# Build
.vs/
out/
# No bare "build/" rule: on Windows (case-insensitive) it would also ignore the Unreal-style
# Engine/Build and Engine/Platforms/*/Build folders. Legacy build trees are listed explicitly.
build-ninja/
build-linux/
cmake-build-*/
compile_commands.json
Engine/build-ninja/
Engine/build-vs/
Tools/build/
Tools/build-fast/
Tools/build-ninja/
Projects/*/build/
Projects/*/build-fast/
Projects/*/build-ninja/
Projects/*/build-linux/
Projects/*/build-ps2/
Projects/*/Shipping/
Samples/*/build-ps2/
*.elf
dist/
Dist/

# FetchContent source trees (any build dir)
**/_deps/


# Binaries / objects (keep mesh assets)
*.exe
*.pdb
*.ilk
*.lib
*.dll
*.exp
*.o
*.a
*.obj
!assets/**/*.obj
!Engine/Assets/**/*.obj

# DCC source (not needed at runtime)
*.max
*.mb
*.blend1

# IDE / OS / tooling
.idea/
.cache/
__pycache__/
*.user
*.suo
.DS_Store
Thumbs.db

# Keep Engine/Build (case-insensitive filesystems also match build/ rules above).
!/Engine/Build/
!/Engine/Build/**
