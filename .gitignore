# Unreal-style generated folders (LeonBuildTool)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
/compile_commands.json
!/Engine/Build/
!/Engine/Build/**
# Downloaded third-party sources (Setup.bat)
Engine/Source/ThirdParty/*/*-[0-9]*/
Engine/Plugins/**/ThirdParty/*/*-[0-9]*/

# Build
.vs/
out/
# No bare "build/" rule: on Windows (case-insensitive) it would also ignore the Unreal-style
# Engine/Build and Engine/Platforms/*/Build folders.
cmake-build-*/
*.elf

# FetchContent source trees (any build dir)
**/_deps/


# Binaries / objects (the test fixtures' OBJ meshes are kept below)
*.exe
*.pdb
*.ilk
*.lib
*.dll
*.exp
*.o
*.a
*.obj

# DCC source (not needed at runtime)
*.max
*.mb
*.blend1

# IDE / OS / tooling
.idea/
.cache/
__pycache__/
*.user
*.suo
.DS_Store
Thumbs.db

!Engine/Source/**/Tests/Fixtures/*.obj
Packages/
.vscode/
