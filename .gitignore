# Unreal-style generated folders (LeonBuildTool)
Binaries/
Intermediate/
Saved/
# Reserved UE-style DDC root: unused until a Derived Data Cache pipeline exists; keep ignored so a local folder cannot be committed by mistake.
DerivedDataCache/
/compile_commands.json
!/Engine/Build/
!/Engine/Build/**
# Downloaded third-party sources (Setup.bat)
Engine/Source/ThirdParty/*/*-[0-9]*/
Engine/Plugins/**/ThirdParty/*/*-[0-9]*/

# Build
.vs/
out/
# No bare "build/" rule: on Windows (case-insensitive) it would also ignore the Unreal-style
# Engine/Build and Engine/Platforms/*/Build folders.
cmake-build-*/
*.elf

# FetchContent source trees (any build dir)
**/_deps/


# Binaries / objects
*.exe
*.pdb
*.ilk
*.lib
*.dll
*.exp
*.o
*.a
*.obj

# DCC source (not needed at runtime)
*.max
*.mb
*.blend1

# IDE / OS / tooling
.idea/
.cache/
__pycache__/
*.user
*.suo
.DS_Store
Thumbs.db

Packages/
.vscode/
