# clangd: root compile_commands.json written by GenerateProjectFiles.bat / LeonBuildTool
# (-Mode=GenerateClangDatabase). QueryDriver lets clangd ask cl.exe for the MSVC system include paths.
CompileFlags:
  CompilationDatabase: .
  Add:
    - -Wno-unused-command-line-argument
    - -Wno-unused-const-variable

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Remove:
      - cert-err33-c
      - readability-suspicious-call-argument
      - readability-math-missing-parentheses
      - readability-avoid-nested-conditional-operator
      - bugprone-implicit-widening-of-multiplication-result
      - performance-enum-size
      - readability-make-member-function-const
      - cppcoreguidelines-pro-type-const-cast
      - cppcoreguidelines-narrowing-conversions
      - cppcoreguidelines-avoid-do-while
      - misc-use-anonymous-namespace

---
# Third-party code: no diagnostics.
If:
  PathMatch: .*/ThirdParty/.*
Diagnostics:
  Suppress: "*"
  ClangTidy:
    Remove: "*"
